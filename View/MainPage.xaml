<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.MainPage"
             Title="Main Menu">

    <VerticalStackLayout Padding="30" Spacing="25">

        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <Button x:Name="LayoutsButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding LayoutsButton}"
                    Command="{Binding OnLayoutsClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <Button x:Name="StackLayoutButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding ImagesButton}"
                    Style="{StaticResource TitleButton}"/>

            <!-- Row 1 -->
            <Button x:Name="CollectionsButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding CollectionsButton}"
                    Style="{StaticResource TitleButton}"/>

            <Button x:Name="ControlsButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding ControlsButton}"
                    Style="{StaticResource TitleButton}"/>

            <!-- Row 2 -->
            <Button x:Name="SQLiteButton"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="{Binding SQLiteButton}"
                    Style="{StaticResource TitleButton}"/>

        </Grid>
    </VerticalStackLayout>

</ContentPage>



