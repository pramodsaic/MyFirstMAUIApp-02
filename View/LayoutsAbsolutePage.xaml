<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.Views.LayoutsAbsolutePage"
             Title="{Binding AbsoluteLayoutTitle}">

    <AbsoluteLayout>

            <!-- Title -->
            <Label Text="Absolute!"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               AbsoluteLayout.LayoutBounds="0.5, 0.1, 300, 50"
               AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- Grid of Boxes -->
            <!-- Row 1 -->
            <Grid AbsoluteLayout.LayoutBounds="0.5, 0.3, 360, 60"
              AbsoluteLayout.LayoutFlags="PositionProportional"
              ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <BoxView Color="#228B22"/>
                    <Label Text="01" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="1">
                    <BoxView Color="#DC143C"/>
                    <Label Text="02" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="2">
                    <BoxView Color="#FFA07A"/>
                    <Label Text="03" TextColor="Black" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="3">
                    <BoxView Color="#ADD8E6"/>
                    <Label Text="04" TextColor="Black" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Row 2 -->
            <Grid AbsoluteLayout.LayoutBounds="0.5, 0.45, 360, 60"
              AbsoluteLayout.LayoutFlags="PositionProportional"
              ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <BoxView Color="#006400"/>
                    <Label Text="05" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="1">
                    <BoxView Color="#8B0000"/>
                    <Label Text="06" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="2">
                    <BoxView Color="#90EE90"/>
                    <Label Text="07" TextColor="Black" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="3">
                    <BoxView Color="#FFD700"/>
                    <Label Text="08" TextColor="Black" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Row 3 -->
            <Grid AbsoluteLayout.LayoutBounds="0.5, 0.6, 360, 60"
              AbsoluteLayout.LayoutFlags="PositionProportional"
              ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <BoxView Color="#A0522D"/>
                    <Label Text="09" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="1">
                    <BoxView Color="#00CED1"/>
                    <Label Text="10" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="2">
                    <BoxView Color="#808080"/>
                    <Label Text="11" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="3">
                    <BoxView Color="#9370DB"/>
                    <Label Text="12" TextColor="White" FontSize="24" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
            </Grid>

        </AbsoluteLayout>
    </ContentPage>

