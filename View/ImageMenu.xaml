<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.ImageMenu"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="25">
        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Row 0 -->
            <Button Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding ButtonTextURIImages}"
                    Command="{Binding URIImagesClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding ButtonTextEmbeddedImages}"
                    Command="{Binding EmbeddedImagesClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <!-- Row 1 -->
            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding ButtonTextActivity}"
                    Command="{Binding ActivityClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

        </Grid>
    </VerticalStackLayout>

</ContentPage>


