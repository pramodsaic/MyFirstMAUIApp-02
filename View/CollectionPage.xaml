<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.CollectionPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="25">
        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding ButtonTextCollectionsIn}"
                    TextColor="Red"
                    FontSize="Large"
                    Command="{Binding MarvelMoviesClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding ButtonTextCollectionImages}"
                    TextColor="Aqua"
                    FontSize="Large"
                    Command="{Binding CollectionWImagesClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <Button Grid.Row="2"
                    Grid.Column="0"
                    Text="{Binding ButtonTextCollectionButtons}"
                    TextColor="Yellow"
                    FontSize="Large"
                    Command="{Binding CollectionButtonsClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

            <Button Grid.Row="3"
                    Grid.Column="0"
                    Text="{Binding ButtonTextCollectionIcons}"
                    TextColor="Green"
                    FontSize="Large"
                    Command="{Binding CollectionIconsClickedCommand}"
                    Style="{StaticResource TitleButton}"/>

        </Grid>
    </VerticalStackLayout>

</ContentPage>