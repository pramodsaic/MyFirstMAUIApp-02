<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.LayoutsPage"
             Title="{Binding LayoutsTitle}">


    <VerticalStackLayout Padding="30" Spacing="25">
        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Row 0 -->
            


            <Button x:Name="VerticalLayoutButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding ButtonTextVerticalLayout}"
                    Style="{StaticResource TitleButton}"/>


            <!-- Row 1 -->
            <Button x:Name="HorizontalLayoutButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding ButtonTextHorizontalLayout}"
                    Style="{StaticResource TitleButton}"/>


            <Button x:Name="AbsoluteLayoutButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding ButtonTextAbsoluteLayout}"
                    Style="{StaticResource TitleButton}"/>
            <Button x:Name="FlexLayoutButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding ButtonTextFlexLayout}"
                    Style="{StaticResource TitleButton}"/>
            <Button x:Name="StackLayoutButton"
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="{Binding ButtonTextStackLayout}"
                    Style="{StaticResource TitleButton}"/>


        </Grid>
    </VerticalStackLayout>


</ContentPage>






