<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyFirstMAUIApp.Model.Entities"
             x:Class="MyFirstMAUIApp.View.CollectionGOGwImagesPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="10">
        <CollectionView x:Name="ItemsListView"
                        ItemsSource="{Binding MarvelCharactersCollection}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MarvelCharacters">
                    <Grid Padding="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="{Binding ImagePath}"
                               WidthRequest="128" HeightRequest="128" Aspect="AspectFill"
                               VerticalOptions="Start" HorizontalOptions="Start" />

                        <VerticalStackLayout Grid.Column="1"
                                             Padding="0,0,0,0"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             Spacing="2">
                            <Label Text="{Binding NameofCharacter}"
                                   FontAttributes="Bold" TextColor="Green" FontSize="Small" />
                            <Label Text="{Binding NameofActor}"
                                   FontAttributes="Italic"
                                   TextColor="Blue"
                                   FontSize="Small" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </VerticalStackLayout>
</ContentPage>